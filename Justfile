default:
    @just --list

check:
    zig build check

test:
    zig build test --summary failures

format:
    zig fmt build.zig src

run *args:
    zig build run -- {{args}}

install:
    zig build -Doptimize=ReleaseFast --prefix ~/.local

# Re-record goldens: fixtures via POST /markdown (gfm mode renders soft breaks as <br>),
# real READMEs as raw source plus GitHub's README view.
record:
    #!/usr/bin/env bash
    set -euo pipefail
    for md in tests/markdown/*.md; do
        jq -n --rawfile t "$md" '{text: $t, mode: "gfm", context: "github/cmark-gfm"}' \
            | gh api -X POST /markdown --input - > "${md%.md}.github.html"
    done
    mkdir -p tests/readme
    for repo in github/cmark-gfm sindresorhus/github-markdown-css; do
        name="${repo#*/}"
        gh api -H 'Accept: application/vnd.github.raw' "/repos/$repo/readme" > "tests/readme/$name.md"
        gh api -H 'Accept: application/vnd.github.html' "/repos/$repo/readme" > "tests/readme/$name.github.html"
    done

# Regenerate the lexbor C source list after bumping the lexbor dependency.
lexbor-sources:
    #!/usr/bin/env bash
    set -euo pipefail
    zig build --fetch
    hash=$(rg -A2 '^\s*\.lexbor = ' build.zig.zon | rg -o 'N-V-[A-Za-z0-9_-]+')
    cd "zig-pkg/$hash/source/lexbor"
    {
        echo '//! Generated by `just lexbor-sources`.'
        echo 'pub const modules: []const []const u8 = &.{'
        find core dom encoding html ns tag -name '*.c' | sort | sed 's/.*/    "&",/'
        echo '};'
    } > "{{justfile_directory()}}/build/lexbor_sources.zig"

# Refresh GitHub's custom (non-Unicode) emoji names from its emoji API.
custom-emoji:
    gh api /emojis --jq 'to_entries[] | select(.value | contains("/unicode/") | not) | .key' | sort > data/custom-emoji.txt

# Regenerate the relative-time golden table from GitHub's relative-time-element, run under bun.
relative-time-golden:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    for f in duration duration-format-ponyfill intl-cache; do
        curl -sSfL "https://unpkg.com/@github/relative-time-element@5.3.1/dist/$f.js" -o "$dir/$f.js"
    done
    cp tests/time/gen.mjs "$dir/"
    TZ=America/Chicago bun "$dir/gen.mjs" > tests/time/relative-chicago.txt
    rm -r "$dir"
